<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_course_list" model="ir.ui.view">
        <field name="name">course.course.list</field>
        <field name="model">course.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="staff_id"/>
                <field name="average_age"/>
            </list>
        </field>
    </record>

    <record id="view_course_form" model="ir.ui.view">
        <field name="name">course.course.form</field>
        <field name="model">course.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Course Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Responsible">
                            <field name="teacher_id"/>
                            <field name="staff_id"/>
                        </group>
                        <group string="Statistics">
                            <field name="average_age"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Course description…" nolabel="1"/>
                        </page>
                        <page string="Students">
                            <field name="student_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="age"/>
                                    <field name="date_of_birth"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_course_search" model="ir.ui.view">
        <field name="name">course.course.search</field>
        <field name="model">course.course</field>
        <field name="arch" type="xml">
            <search string="Courses">
                <field name="name" filter_domain="[('name', 'ilike', self)]"/>
                <field name="teacher_id"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Teacher" name="group_teacher"
                            context="{'group_by': 'teacher_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">course.course</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_course_search"/>
    </record>

</odoo>
